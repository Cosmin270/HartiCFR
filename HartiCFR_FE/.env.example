# Base URL of the HartiCFR backend API.
#
# Leave unset for local development (defaults to http://localhost:5016) and on
# Render, where the site proxies /api to the backend so requests stay
# same-origin -- which is what keeps the auth cookie working in Safari.
# Set this only when pointing a build at an API somewhere else.
# VITE_API_URL=https://api.example.com
